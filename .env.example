# ===========================================
# Bitcoin Blocks App - Environment Variables
# ===========================================

# Public web URL (required)
NEXT_PUBLIC_APP_URL=https://bitcoin-blocks-app.vercel.app

# Auth domain for SIWE verification (no scheme, just hostname)
AUTH_DOMAIN=bitcoin-blocks-app.vercel.app

# ===========================================
# Neynar API (Farcaster)
# ===========================================
# Get your API key from https://neynar.com
NEYNAR_API_KEY=FILL_ME
NEXT_PUBLIC_NEYNAR_CLIENT_ID=FILL_ME

# ===========================================
# Supabase (Database)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Mempool API
# ===========================================
MEMPOOL_API_BASE=https://mempool.space/api

# ===========================================
# Admin Configuration
# ===========================================
# Comma-separated list of Farcaster FIDs that have admin access
NEXT_PUBLIC_ADMIN_FIDS=250704,1107084

# Comma-separated list of wallet addresses that have admin access
NEXT_PUBLIC_ADMIN_WALLETS=0x09d02d25d0d082f7f2e04b4838cefe271b2dab09

# ===========================================
# Farcaster Frame Images
# ===========================================
NEXT_PUBLIC_FRAME_IMAGE_URL=https://example.vercel-storage.com/thumbnail.png
NEXT_PUBLIC_SPLASH_IMAGE_URL=https://example.vercel-storage.com/splash.svg

# ===========================================
# Blockchain Configuration (Base Mainnet)
# ===========================================
NEXT_PUBLIC_CHAIN_ID=8453

# $SECOND Token on Base Mainnet
NEXT_PUBLIC_SECOND_TOKEN_ADDRESS=0xce9199a0c05446ceed4f0f928c864b7a2f9f86b3
REWARD_TOKEN_ADDRESS=0xce9199a0c05446ceed4f0f928c864b7a2f9f86b3

# Base RPC URL (optional, uses public RPC if not set)
BASE_RPC_URL=https://mainnet.base.org

# ===========================================
# Reward Claimer Contract
# ===========================================
# Contract address for claiming rewards
REWARD_CLAIMER_ADDRESS=0x80Fd04c6C4D43C2434512CdAe05E30c46f3a330D

# Private key of the signer wallet (KEEP SECRET!)
# This wallet must be set as the signer in the RewardClaimer contract
REWARD_SIGNER_PRIVATE_KEY=FILL_ME

# ===========================================
# Optional: Cron Job Security
# ===========================================
# Secret for authenticating cron job requests
CRON_SECRET=FILL_ME

# ===========================================
# UI Defaults
# ===========================================
NEXT_PUBLIC_DEFAULT_CURRENCY=$SECOND
