# Public web URL
NEXT_PUBLIC_APP_URL=https://bitcoin-blocks-app.vercel.app

# QuickAuth verification domain (no scheme)
AUTH_DOMAIN=bitcoin-blocks-app.vercel.app

# Farcaster API key (server-only)
FARCASTER_API_KEY=FILL_ME

# Neynar Web login
NEXT_PUBLIC_NEYNAR_CLIENT_ID=FILL_ME
NEYNAR_API_KEY=FILL_ME

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mempool API (server-only)
MEMPOOL_API_BASE=https://mempool.space/api

# Admin controls (public)
NEXT_PUBLIC_ADMIN_FIDS=250704,1107084
NEXT_PUBLIC_ADMIN_WALLETS=0x09d02d25d0d082f7f2e04b4838cefe271b2dab09,0xc38b1633e152fc75da3ff737717c0da5ef291408

# Farcaster frame and splash images
NEXT_PUBLIC_FRAME_IMAGE_URL=https://example.vercel-storage.com/thumbnail.png
NEXT_PUBLIC_SPLASH_IMAGE_URL=https://example.vercel-storage.com/splash.svg

# Base Mainnet for $SECOND token
NEXT_PUBLIC_CHAIN_ID=8453

# $SECOND Token on Base Mainnet
NEXT_PUBLIC_SECOND_TOKEN_ADDRESS=0xce9199a0c05446ceed4f0f928c864b7a2f9f86b3

# Onchain reward config
REWARD_TOKEN_ADDRESS=0xce9199a0c05446ceed4f0f928c864b7a2f9f86b3
BASE_RPC_URL=https://mainnet.base.org

# Reward signer private key (KEEP SECRET!)
REWARD_SIGNER_PRIVATE_KEY=FILL_ME

# UI default
NEXT_PUBLIC_DEFAULT_CURRENCY=$SECOND
