# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Neynar API (for Farcaster user lookup)
NEXT_PUBLIC_NEYNAR_API_KEY=your_neynar_api_key

# Mempool API (Bitcoin blockchain data)
MEMPOOL_API_BASE=https://mempool.space/api

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_FIDS=250704,1107084

# $SECOND Token - Base Mainnet (Production)
NEXT_PUBLIC_SECOND_TOKEN_ADDRESS=your_token_address
NEXT_PUBLIC_SECOND_TOKEN_CHAIN_ID=8453

# $SECOND Token - Base Sepolia (Testing)
NEXT_PUBLIC_TEST_TOKEN_ADDRESS=your_test_token_address
NEXT_PUBLIC_TEST_CLAIM_CONTRACT=your_claim_contract_address
NEXT_PUBLIC_TEST_TOKEN_CHAIN_ID=84532

# Deployer wallet (for admin operations)
# WARNING: Never commit private keys! Set DEPLOYER_PRIVATE_KEY in CI/server environment only
DEPLOYER_ADDRESS=your_deployer_address
