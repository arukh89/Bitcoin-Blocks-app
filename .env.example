# ===========================================
# Bitcoin Blocks App - Environment Variables
# ===========================================
# SECURITY: Never commit actual values to git!
# Copy this file to .env.local and fill in real values
# ===========================================

# Public web URL (required)
# Auth domain is derived from this URL automatically
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ===========================================
# Neynar API (Farcaster)
# ===========================================
# Get your API key from https://neynar.com
# REQUIRED for Farcaster user resolution and authentication
NEYNAR_API_KEY=your-neynar-api-key
NEXT_PUBLIC_NEYNAR_CLIENT_ID=your-neynar-client-id

# ===========================================
# Supabase (Database)
# ===========================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Mempool API
# ===========================================
MEMPOOL_API_BASE=https://mempool.space/api

# ===========================================
# Admin Configuration
# ===========================================
# Comma-separated list of Farcaster FIDs that have admin access
# Example: 250704,1107084
NEXT_PUBLIC_ADMIN_FIDS=

# Comma-separated list of wallet addresses that have admin access
# Example: 0x09d02d25d0d082f7f2e04b4838cefe271b2dab09
NEXT_PUBLIC_ADMIN_WALLETS=

# ===========================================
# Farcaster Frame Images
# ===========================================
NEXT_PUBLIC_FRAME_IMAGE_URL=https://your-storage.com/thumbnail.png
NEXT_PUBLIC_SPLASH_IMAGE_URL=https://your-storage.com/splash.svg

# ===========================================
# Blockchain Configuration (Base Mainnet)
# ===========================================
# Use 8453 for Base Mainnet, 84532 for Base Sepolia
NEXT_PUBLIC_CHAIN_ID=8453

# $SECOND Token on Base Mainnet (used for rewards)
# This is used both client-side (NEXT_PUBLIC_) and server-side
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=0xce9199a0c05446ceed4f0f928c864b7a2f9f86b3

# Optional: Separate check-in reward token/contract (if different from main)
# REWARD_TOKEN_CHECKIN_ADDRESS=
# REWARD_CLAIMER_CHECKIN_ADDRESS=

# Legacy aliases (deprecated - use NEXT_PUBLIC_REWARD_TOKEN_ADDRESS instead)
# REWARD_TOKEN_ADDRESS - now use NEXT_PUBLIC_REWARD_TOKEN_ADDRESS
# NEXT_PUBLIC_SECOND_TOKEN_ADDRESS - now use NEXT_PUBLIC_REWARD_TOKEN_ADDRESS
# AUTH_DOMAIN - now derived from NEXT_PUBLIC_APP_URL
# FARCASTER_API_KEY - now use NEYNAR_API_KEY

# Base RPC URL (optional, uses public RPC if not set)
BASE_RPC_URL=https://mainnet.base.org

# ===========================================
# Reward Claimer Contract
# ===========================================
# Contract address for claiming rewards
REWARD_CLAIMER_ADDRESS=0x80Fd04c6C4D43C2434512CdAe05E30c46f3a330D

# ===========================================
# SECRETS - NEVER COMMIT THESE VALUES!
# ===========================================
# Private key of the signer wallet
# This wallet must be set as the signer in the RewardClaimer contract
# Generate a new wallet and set it as signer via setSigner()
REWARD_SIGNER_PRIVATE_KEY=

# Secret for authenticating cron job requests (REQUIRED)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ===========================================
# UI Defaults
# ===========================================
NEXT_PUBLIC_DEFAULT_CURRENCY=$SECOND
